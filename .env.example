# Copiá este archivo a ".env" y completá con los valores de tu proyecto de Supabase.
# Los encontrás en: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# OPCIONAL — captcha del login anónimo (Cloudflare Turnstile).
# Si la dejás vacía o la borrás, la app funciona igual (sin captcha).
# Para activarlo hacen falta las dos puntas:
#   1. La site key pública de tu widget en https://dash.cloudflare.com (Turnstile).
#   2. La secret key cargada en Supabase Dashboard >
#      Authentication > Settings > Bot and Abuse Protection.
# El orden importa: desplegá PRIMERO la app con esta variable (mandar un token
# de más es inofensivo, Supabase lo ignora mientras el captcha esté apagado) y
# recién después activalo en Supabase. Al revés, el login anónimo queda roto
# hasta el deploy: Supabase pide un token que la app todavía no manda.
VITE_TURNSTILE_SITE_KEY=
